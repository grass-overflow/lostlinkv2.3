# Database Configuration
# Use mongodb://localhost:27017 for local runs, or mongodb://mongo:27017 when running with docker-compose
MONGO_URI=mongodb://mongo:27017

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Security Settings
JWT_SECRET=secret123_change_this_in_production

# Notification Services (Gmail SMTP)
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_app_password

# Telephony Services (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=your_twilio_phone_number
